{
  "opencollection": "1.0.0",
  "info": {
    "name": "Flutterwave Banks AccountResolution Fees API",
    "version": "4.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Fees",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Fees",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.flutterwave.cloud/f4b/production/fees",
            "params": [
              {
                "name": "amount",
                "value": "",
                "type": "query"
              },
              {
                "name": "currency",
                "value": "",
                "type": "query"
              },
              {
                "name": "payment_method",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve transaction fees for a payment amount, currency, and method combination."
        }
      ]
    }
  ],
  "bundled": true
}