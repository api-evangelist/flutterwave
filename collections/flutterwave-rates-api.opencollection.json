{
  "opencollection": "1.0.0",
  "info": {
    "name": "Flutterwave Banks AccountResolution Rates API",
    "version": "4.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Rates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Rate Conversion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.flutterwave.cloud/f4b/production/transfers/rates",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve transfer rate for international transfers."
        },
        {
          "info": {
            "name": "Fetch Converted Rate",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.flutterwave.cloud/f4b/production/transfers/rates/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Fetch Converted Rate"
        }
      ]
    }
  ],
  "bundled": true
}