          "request": {
            "name": "Receive Flutterwave Webhook",
            "description": {
              "content": "Endpoint hosted by the merchant. Flutterwave POSTs a JSON payload and\nsets the `verif-hash` header to the secret hash configured in the\ndashboard. Validate `verif-hash` before trusting the payload.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "webhooks",
                "flutterwave"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Pre-shared secret hash configured by the merchant.",
                "key": "verif-hash",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
