              "mode": "raw",
              "raw": "{\n  \"type\": \"<string>\",\n  \"data\": {\n    \"id\": \"<string>\",\n    \"amount\": \"<number>\",\n    \"currency\": \"<string>\",\n    \"status\": \"<string>\",\n    \"reference\": \"<string>\",\n    \"customer\": {\n      \"id\": \"<string>\",\n      \"email\": \"<email>\"\n    },\n    \"payment_method\": {\n      \"type\": \"<string>\"\n    },\n    \"processor_response\": {\n      \"type\": \"<string>\",\n      \"code\": \"<string>\"\n    },\n    \"created_datetime\": \"<dateTime>\",\n    \"meta\": \"<object>\"\n  }\n}",
